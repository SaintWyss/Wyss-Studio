{
  "name": "wyss-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "composer:dev": "npm --workspace @wyss-studio/web run dev",
    "composer:build": "npm --workspace @wyss-studio/web run build",
