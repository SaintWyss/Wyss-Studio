{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyss.local/schemas/studio-project-1.0.0.json",
  "title": "Wyss Studio Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "schemaVersion", "device", "screens", "activeScreenId", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "width", "height", "target"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "target": { "enum": ["esp32", "mobile", "desktop"] }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "background", "components"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "background": { "type": "string" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "name", "x", "y", "width", "height", "text", "background", "color", "borderRadius", "fontSize", "action"],
              "properties": {
                "id": { "type": "string" },
                "type": { "enum": ["text", "button", "switch", "card", "status", "progress"] },
                "name": { "type": "string" },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 32 },
                "height": { "type": "integer", "minimum": 24 },
                "text": { "type": "string" },
                "background": { "type": "string" },
                "color": { "type": "string" },
                "borderRadius": { "type": "integer", "minimum": 0, "maximum": 100 },
                "fontSize": { "type": "integer", "minimum": 8, "maximum": 96 },
                "value": { "type": ["number", "boolean", "string", "null"] },
                "action": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "enum": ["none", "navigate", "wyss.command"] },
                    "value": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "activeScreenId": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
